@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Quản Lý Chuyên Mục";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h3 class="fw-bold mb-1">Quản Lý Chuyên Mục</h3>
        <p class="text-muted mb-0 small">Khu vực dành cho Nhân viên (Staff) quản lý các chuyên mục tin tức</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-folder-plus me-1"></i> Thêm Chuyên Mục
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<!-- Search Bar -->
<div class="card card-clean p-3 mb-4">
    <form method="get" asp-controller="Category" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm kiếm theo tên chuyên mục hoặc mô tả..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search me-1"></i> Tìm kiếm
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Keyword as string))
            {
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
            }
        </div>
    </form>
</div>

<!-- Table -->
<div class="card card-clean">
    <div class="table-responsive">
        <table class="table table-clean table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã</th>
                    <th>Tên Chuyên Mục</th>
                    <th>Mô Tả</th>
                    <th>Chuyên Mục Cha</th>
                    <th>Trạng Thái</th>
                    <th class="text-end" style="width: 160px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Không tìm thấy chuyên mục nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@cat.CategoryID</td>
                            <td class="fw-semibold">@cat.CategoryName</td>
                            <td class="text-muted small">@cat.CategoryDesciption</td>
                            <td>
                                @if (cat.ParentCategory != null && cat.ParentCategoryID != cat.CategoryID)
                                {
                                    <span class="badge bg-light text-dark border">@cat.ParentCategory.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chuyên mục gốc</span>
                                }
                            </td>
                            <td>
                                @if (cat.IsActive == true)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Vô hiệu</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                        data-bs-toggle="modal" data-bs-target="#editModal_@cat.CategoryID">
                                    <i class="bi bi-pencil"></i> Sửa
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmDelete('@cat.CategoryID', '@cat.CategoryName')">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                                <form id="deleteForm_@cat.CategoryID" method="post" asp-controller="Category" asp-action="Delete" asp-route-id="@cat.CategoryID" class="d-none">
                                    @Html.AntiForgeryToken()
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Modals (Outside table) -->
@if (Model != null && Model.Any())
{
    foreach (var cat in Model)
    {
        <div class="modal fade" id="editModal_@cat.CategoryID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-controller="Category" asp-action="Edit" asp-route-id="@cat.CategoryID">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Chỉnh Sửa Chuyên Mục #@cat.CategoryID</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tên Chuyên Mục</label>
                                <input type="text" name="CategoryName" value="@cat.CategoryName" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Mô Tả Chuyên Mục</label>
                                <textarea name="CategoryDesciption" class="form-control" rows="3" required>@cat.CategoryDesciption</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Chuyên Mục Cha</label>
                                <select name="ParentCategoryID" class="form-select">
                                    <option value="">Không có (Là chuyên mục gốc)</option>
                                    @foreach (var parent in Model.Where(c => c.CategoryID != cat.CategoryID))
                                    {
                                        <option value="@parent.CategoryID" selected="@(cat.ParentCategoryID == parent.CategoryID)">@parent.CategoryName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="activeCheck_@cat.CategoryID" @(cat.IsActive == true ? "checked" : "") />
                                <label class="form-check-label small" for="activeCheck_@cat.CategoryID">Chuyên mục đang hoạt động</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="submit" class="btn btn-primary btn-sm">Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Create Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Category" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Thêm Chuyên Mục Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên Chuyên Mục</label>
                        <input type="text" name="CategoryName" class="form-control" placeholder="Ví dụ: Công nghệ thông tin" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô Tả Chuyên Mục</label>
                        <textarea name="CategoryDesciption" class="form-control" rows="3" placeholder="Nhập mô tả ngắn gọn..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Chuyên Mục Cha</label>
                        <select name="ParentCategoryID" class="form-select">
                            <option value="">Không có (Là chuyên mục gốc)</option>
                            @if (Model != null)
                            {
                                @foreach (var parent in Model)
                                {
                                    <option value="@parent.CategoryID">@parent.CategoryName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked id="createActiveCheck" />
                        <label class="form-check-label small" for="createActiveCheck">Chuyên mục đang hoạt động</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary btn-sm">Tạo Chuyên Mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa chuyên mục?',
                html: `Bạn có chắc chắn muốn xóa chuyên mục <strong>${name}</strong> (#${id})?<br><small class='text-muted'>Lưu ý: Không thể xóa chuyên mục đang có bài viết liên kết.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm_' + id).submit();
                }
            });
        }
    </script>
}
