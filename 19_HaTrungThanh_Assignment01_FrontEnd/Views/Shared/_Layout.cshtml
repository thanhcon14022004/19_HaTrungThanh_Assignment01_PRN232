@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("AccountName");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews Management System</title>
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-newspaper"></i> FUNews System
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang Chủ
                            </a>
                        </li>

                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Quản Lý Tài Khoản
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                                    <i class="bi bi-graph-up me-1"></i> Báo Cáo Thống Kê
                                </a>
                            </li>
                        }
                        else if (role == "Staff")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Category" ? "active" : "")" asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-folder me-1"></i> Quản Lý Chuyên Mục
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "NewsArticle" && currentAction == "Index" ? "active" : "")" asp-controller="NewsArticle" asp-action="Index">
                                    <i class="bi bi-file-earmark-text me-1"></i> Quản Lý Bài Viết
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "NewsArticle" && currentAction == "History" ? "active" : "")" asp-controller="NewsArticle" asp-action="History">
                                    <i class="bi bi-clock-history me-1"></i> Lịch Sử Đã Đăng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person me-1"></i> Hồ Sơ Cá Nhân
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <span class="text-light me-2 small">
                                <i class="bi bi-person-circle me-1"></i>@userName 
                                <span class="badge @(role == "Admin" ? "bg-warning text-dark" : "bg-info text-dark") ms-1">
                                    @(role == "Admin" ? "Admin" : "Staff")
                                </span>
                            </span>
                            <a asp-controller="Login" asp-action="Logout" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Đăng Xuất
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng Nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-clean mt-auto">
        <div class="container d-flex justify-content-between align-items-center small">
            <div>
                &copy; @DateTime.Now.Year - FUNews Management System - <strong>19_HaTrungThanh</strong>
            </div>
            <div>
                PRN232 Assignment 01 &bull; .NET 8 &bull; ASP.NET Core Web API
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
