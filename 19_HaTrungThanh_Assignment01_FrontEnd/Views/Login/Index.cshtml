@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <div class="card card-clean">
            <div class="card-header bg-white py-3 border-bottom text-center">
                <h4 class="fw-bold mb-0">Đăng Nhập</h4>
                <small class="text-muted">Hệ Thống Quản Lý Tin Tức FUNews</small>
            </div>

            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                {
                    <div class="alert alert-danger py-2 small d-flex align-items-center mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <div>@ViewBag.ErrorMessage</div>
                    </div>
                }

                <form method="post" asp-controller="Login" asp-action="Index">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email</label>
                        <input asp-for="Email" id="inputEmail" type="email" class="form-control" placeholder="name@domain.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu</label>
                        <input asp-for="Password" id="inputPassword" type="password" class="form-control" placeholder="Mật khẩu" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Đăng Nhập
                    </button>
                </form>

                <!-- Tài khoản thử nghiệm nhanh (Hỗ trợ chấm bài) -->
                <div class="mt-4 pt-3 border-top text-center">
                    <small class="text-muted d-block mb-2">Tài khoản điền nhanh (Test):</small>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnFillAdmin">
                            Admin
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnFillStaff">
                            Staff
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const at = String.fromCharCode(64);

        document.getElementById('btnFillAdmin').addEventListener('click', function() {
            document.getElementById('inputEmail').value = 'admin' + at + 'FUNewsManagementSystem.org';
            document.getElementById('inputPassword').value = at + at + 'abc123' + at + at;
        });

        document.getElementById('btnFillStaff').addEventListener('click', function() {
            document.getElementById('inputEmail').value = 'thanhhthe182267' + at + 'fpt.edu.vn';
            document.getElementById('inputPassword').value = 'Hathanh55';
        });
    </script>
}
